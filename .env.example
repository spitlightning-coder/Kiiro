# Discord Bot-Token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Welches Gehirn: anthropic (Claude direkt) oder openai (OpenAI-kompatibel, z.B. Requesty)
DAVE_PROVIDER=anthropic

# Nur für DAVE_PROVIDER=openai: Adresse + Key (Requesty: app.requesty.ai -> API Keys)
# DAVE_API_BASE=https://router.requesty.ai/v1
DAVE_API_KEY=
# DAVE_MODEL darf dann eine Liste sein, das nächste springt ein, wenn eins zickt:
# DAVE_MODEL=nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it

# Anthropic API-Key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Kanal-IDs, in denen Dave auf JEDE Nachricht antwortet (kommagetrennt).
# Rechtsklick auf Kanal -> "Kanal-ID kopieren" (Entwicklermodus muss an sein).
DAVE_CHANNEL_IDS=

# Optional
# DAVE_MODEL=claude-opus-5-5
# DAVE_EFFORT=low              # low | medium | high
# DAVE_MEMORY_MESSAGES=20      # wie viele letzte Nachrichten pro Kanal Dave sich merkt
# DAVE_MEMORY_MINUTES=60       # danach vergisst er den Kanal-Verlauf
# DAVE_MAX_TOKENS=1500
# DAVE_REPLY_TO_BOTS=false
# DAVE_LONGTERM=true          # Langzeitgedächtnis an/aus
# DAVE_LEARN_EVERY=15          # nach so vielen Nachrichten pro Kanal lernt er (kostet 1 Anfrage)
# DAVE_DATA_DIR=data           # wo das Gedächtnis liegt
